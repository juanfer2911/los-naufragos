{
  "realm": "planificador-realm",
  "enabled": true,
  "accessTokenLifespan": 60,
  "registrationAllowed": true,
  "defaultRole": {
    "name": "default-roles-planificador-realm"
  },
  "roles": {
    "realm": [
      { "name": "estudiante" },
      { "name": "docente" },
      {
        "name": "default-roles-planificador-realm",
        "composite": true,
        "composites": {
          "realm": ["estudiante"]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "angular-desarrollo",
      "name": "Angular - desarrollo local",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["basic", "profile", "email", "roles"],
      "protocolMappers": [
        {
          "name": "audiencia-proceso",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "proceso-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "audiencia-planificador",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "planificador-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
