# Variables para exportar en la terminal WSL que inicia Java.
SERVER_PORT=8081
PLANIFICADOR_DB_URL=jdbc:postgresql://localhost:5432/planificador_db
PLANIFICADOR_DB_USER=planificador_user
# Debe coincidir con PLANIFICADOR_DB_PASSWORD de infra/.env.
PLANIFICADOR_DB_PASSWORD=replace-with-local-password
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/planificador-realm
KEYCLOAK_JWK_SET_URI=http://localhost:8080/realms/planificador-realm/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=planificador-service
FRONTEND_ORIGINS=http://localhost:4200
PLANIFICADOR_BIBLIOTECA=/mnt/c/Users/juanf/Documents/los-naufragos/native/libplanificador.so
