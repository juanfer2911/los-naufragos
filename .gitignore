# IntelliJ IDEA: ignore machine/user state, keep shared project configuration
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/shelf/
.idea/httpRequests/
.idea/dataSources/
.idea/dataSources.local.xml
.idea/dictionaries/
.idea/deploymentTargetDropDown.xml
.idea/sshConfigs.xml
.idea/webServers.xml

# Java build output
*.class
target/
.gradle/

# Angular dependencies and generated output
node_modules/
dist/
.angular/

# Native compiled artifacts
*.o
*.so
*.a
*.dll
*.dylib
*.exe
*.out

# Local environment and credentials; keep safe example configuration files
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.secret
*.secrets
*.pem
*.key
*.p12
*.pfx
credentials.local.*
secrets.local.*

# Temporary files and logs
*.log
*.tmp
*.temp
*.swp
*.swo
~$*

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
